{
  "compilerOptions": {
    "module": "esnext",
    "lib": ["ESNext", "DOM", "DOM.AsyncIterable"],
    "types": [
      "w3c-web-serial",
      "w3c-web-usb"
    ],
    "rootDir": "./src/",
    "outDir": "./dist/",
    "sourceMap": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "target": "esnext",
    "declaration": true
  },
  "include": ["./src/**/*"]
}
